    "idempotency_key": {
      "title": "Idempotency Key",
      "type": "string"
    },
    "required_capabilities": {
      "items": {
        "type": "string"
      },
      "title": "Required Capabilities",
      "type": "array"
    },
    "requested_by": {
      "title": "Requested By",
      "type": "string"
    },
    "observation_version": {
      "title": "Observation Version",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    }
  },
  "required": [
    "task_id",
    "operation",
    "channel",
    "target",
    "risk_class",
    "idempotency_key",
    "requested_by",
    "observation_version"
